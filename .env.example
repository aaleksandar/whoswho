# whoswho configuration. Copy to .env and uncomment what you need (.env is git-ignored).
# Variables already set in the shell environment win over this file.

# Port to listen on (all interfaces). Hosts usually set this for you.
# PORT=3000

# SQLite file. On a host, point this at the persistent disk.
# DB_PATH=./whoswho.sqlite
# DB_PATH=/data/whoswho.sqlite

# Required whenever this is not a LAN (PUBLIC_BASE_URL or a public PUBLIC_HOST).
# HTTP Basic auth for /hax0r, any username.
# ADMIN_PASSWORD=

# Public origin guests will open, no trailing slash. QR codes and copied links use this.
# Leave unset on a LAN and the server uses the detected private IP.
# PUBLIC_BASE_URL=https://your-app.fly.dev

# Optional. When set, guest answers (the board, directory, TV, registration) require this
# code. Share https://your-app.fly.dev/?invite=the-code
# The time, place and RSVP stay visible without it.
# INVITE_CODE=

# Optional shared playlist. Shown on the night page. No Spotify login.
# PLAYLIST_URL=https://open.spotify.com/playlist/...

# Optional. Only if the auto-detected LAN IP is wrong (a VPN interface, for example).
# PUBLIC_HOST=

# Optional LLM rewrite of the one-line match reasons. The app works fully without these.
# OpenAI-compatible POST {base}/chat/completions. Reasons fall back to the offline text.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
